{
  "appId": "it.sistembelluno.controllolavori",
  "productName": "Controllo Lavori",
  "electronVersion": "22.3.27",
  "files": [
    "main.js",
    "preload.js",
    "Controllo_Lavori.html"
  ],
  "directories": {
    "output": "dist"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "ia32"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "Controllo-Lavori-${version}-Windows7-32bit-portable.exe"
  },
  "nsis": {
    "artifactName": "Controllo-Lavori-${version}-Windows7-32bit-setup.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
