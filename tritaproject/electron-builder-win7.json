{
  "appId": "it.sistembelluno.tritaproject",
  "productName": "TRITAPROJECT",
  "electronVersion": "22.3.27",
  "files": [
    "main.js",
    "compat.js",
    "preload.js",
    "ai.js",
    "elaborati.js",
    "progetti.js",
    "modello3d.js",
    "dxfletto.js",
    "ui/**"
  ],
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "ia32"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "TRITAPROJECT-${version}-Windows7-32bit-portable.exe"
  },
  "nsis": {
    "artifactName": "TRITAPROJECT-${version}-Windows7-32bit-setup.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
