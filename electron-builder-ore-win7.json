{
  "appId": "it.sistembelluno.oredipendenti",
  "productName": "INSERT_SISTEM",
  "electronVersion": "22.3.27",
  "extraMetadata": {
    "name": "ore-dipendenti",
    "productName": "INSERT_SISTEM"
  },
