{
  "name": "cse-sistem",
  "productName": "CSE_SISTEM",
  "version": "0.2.0",
  "description": "CSE_SISTEM: documentazione del coordinatore per la sicurezza in fase di esecuzione (D.Lgs 81/08)",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "sistembelluno",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win --publish never",
    "android:sync": "cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "it.sistembelluno.csesistem",
    "productName": "CSE_SISTEM",
    "files": ["electron/**", "www/**"],
    "directories": { "output": "dist" },
    "win": { "target": ["portable", "nsis"] },
    "portable": { "artifactName": "CSE_SISTEM-${version}-portable.exe" },
    "nsis": {
      "artifactName": "CSE_SISTEM-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
