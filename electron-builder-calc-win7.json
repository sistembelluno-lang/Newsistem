{
  "appId": "it.sistembelluno.calcsistem",
  "productName": "CALC_SISTEM",
  "electronVersion": "22.3.27",
  "extraMetadata": {
    "name": "calc-sistem",
    "productName": "CALC_SISTEM",
    "main": "calc/main.js"
  },
  "files": [
    "calc/main.js",
    "calc/preload.js",
    "calc/Calc_Sistem.html"
  ],
  "directories": {
    "output": "dist",
    "buildResources": "build-calc"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "ia32"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "CALC_SISTEM-${version}-Windows7-32bit-portable.exe"
  },
  "nsis": {
    "artifactName": "CALC_SISTEM-${version}-Windows7-32bit-setup.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
