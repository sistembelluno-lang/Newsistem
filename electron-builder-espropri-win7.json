{
  "appId": "it.sistembelluno.espropri",
  "productName": "ESPROPRI_SISTEM",
  "extraMetadata": {
    "name": "espropri-sistem",
    "productName": "ESPROPRI_SISTEM"
  },
  "files": [
    "main.js",
    "preload.js",
    "Espropri.html"
  ],
  "directories": {
    "output": "dist",
    "buildResources": "build-espropri"
  },
  "electronVersion": "22.3.27",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "ia32"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "ESPROPRI_SISTEM-${version}-Windows7-32bit-portable.exe"
  },
  "nsis": {
    "artifactName": "ESPROPRI_SISTEM-${version}-Windows7-32bit-setup.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
